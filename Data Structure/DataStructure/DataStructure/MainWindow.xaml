<Window x:Class="DataStructure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataStructure"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">
    <Grid Margin="10">

        <!--ROWS-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Shopping Cart System"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- DATAGRID -->
        <DataGrid x:Name="ShoppingGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  Margin="0,54,618,10"
                  CanUserAddRows="False"
                  SelectionChanged="ShoppingGrid_SelectionChanged">

            <DataGrid.Columns>

                <!-- STUDENT ID -->
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="120"/>

                <!-- NAME -->
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="200"/>

                <!-- Description -->
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="150"/>

                <!-- price -->
                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price}"
                                    Width="120"/>



            </DataGrid.Columns>

        </DataGrid>

        <!-- INPUT AREA -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">

            <WrapPanel>

                <!--  ID -->
                <StackPanel Margin="5">
                    <TextBlock Text="ID"/>
                    <TextBox x:Name="txtId"
                             Width="120" Height="24"/>
                </StackPanel>

                <!--  NAME -->
                <StackPanel Margin="5">
                    <TextBlock Text="Name"/>
                    <TextBox x:Name="txtName"
                             Width="180" Height="24"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Margin="5">
                    <TextBlock Text="Description"/>
                    <TextBox x:Name="txtDescription"
             Width="180" Height="24"/>
                </StackPanel>



                <!-- Price -->
                <StackPanel Margin="5">
                    <TextBlock Text="Price"/>
                    <TextBox x:Name="txtPrice"
                             Width="100" Height="24"/>
                </StackPanel>



                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            Margin="15,20,0,0">

                    <!-- ADD -->
                    <Button x:Name="btnAdd"
                            Content="Add"
                            Width="90"
                            Height="35"
                            Margin="5"
                            Click="btnAdd_Click" Background="#FF5C90F3"/>

                   

                    <!-- REMOVE -->
                    <Button x:Name="btnRemove"
                            Content="Remove Item"
                            Width="90"
                            Height="35"
                            Margin="5"
                            Click="btnRemove_Click" Background="#FF5C90F3"/>

                    <!-- CLEAR -->
                    <Button x:Name="btnClear"
                            Content="Clear"
                            Width="90"
                            Height="35"
                            Margin="5"
                            Click="btnClear_Click" Background="#FF5C90F3"/>
                    
                    <Button x:Name="btnAddtocart"
                        Content="Add to Cart"
                        Width="90"
                        Height="35"
                        Click="btnaddtoCart_Click" Background="#FF5C90F3"/>

                </StackPanel>

            </WrapPanel>

        </Border>
        <Label Content="Available Items" HorizontalAlignment="Left" Height="36" Margin="139,13,0,0" Grid.Row="1" VerticalAlignment="Top" Width="172" FontWeight="Bold" FontSize="16"/>
        <Label Content="Shopping Cart" HorizontalAlignment="Left" Height="36" Margin="796,13,0,0" Grid.Row="1" VerticalAlignment="Top" Width="172" FontWeight="Bold" FontSize="16"/>
        <DataGrid x:Name="AddtoCart"
            Grid.Row="1"
            AutoGenerateColumns="False"
            Margin="590,54,10,10"
            CanUserAddRows="False"
            >

            <DataGrid.Columns>

                <!-- STUDENT ID -->
                <DataGridTextColumn Header="ID"
                    Binding="{Binding Id}"
                    Width="120"/>

                <!-- NAME -->
                <DataGridTextColumn Header="Name"
                    Binding="{Binding Name}"
                    Width="200"/>

                <!-- COURSE -->
                <DataGridTextColumn Header="Description"
                    Binding="{Binding Description}"
                    Width="150"/>

                <!-- YEAR -->
                <DataGridTextColumn Header="Price"
                    Binding="{Binding Price}"
                    Width="120"/>



            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>
